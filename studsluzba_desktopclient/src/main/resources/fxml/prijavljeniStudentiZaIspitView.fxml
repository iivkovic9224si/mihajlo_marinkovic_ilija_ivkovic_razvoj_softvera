<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzbadesktopclient.controllers.PrijavljeniStudentiZaIspitController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TableView fx:id="tableView" prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn fx:id="imeCol" text="Ime" prefWidth="150"/>
            <TableColumn fx:id="prezimeCol" text="Prezime" prefWidth="150"/>
            <TableColumn fx:id="indeksCol" text="Broj/God/Program" prefWidth="150"/>
        </columns>
    </TableView>

</VBox>
