<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.raflab.studsluzbadesktopclient.controllers.StudentAktivnostiController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TitledPane text="Upis / Obnova godine" expanded="true">
        <content>
            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Tip aktivnosti -->
                <Label text="Tip aktivnosti:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="tipAktivnostiCb" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Godina studija -->
                <Label text="Godina studija:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="godinaSpinner" min="1" max="6" initialValue="1"
                         GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Datum -->
                <Label text="Datum:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="datumPicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Program -->
                <Label text="Program:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="programTf" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Godina indeksa -->
                <Label text="Godina indeksa:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="indeksGodinaTf" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Broj indeksa -->
                <Label text="Broj indeksa:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="indeksBrojTf" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Indeks aktivan -->
                <Label text="Indeks aktivan:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <CheckBox fx:id="indeksAktivanCb" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- Napomena -->
                <Label text="Napomena:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextArea fx:id="napomenaTa" prefRowCount="3"
                          GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <!-- 🚀 POSEDNAJA GODINA (NOVI RED 8) -->
                <Label text="Poslednja godina:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <Label fx:id="lblPoslednjaGodina" text="Nema aktivnosti"
                       style="-fx-font-size: 14px; -fx-padding: 5; -fx-background-color: #f0f0f0;"
                       GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <!-- UČITAJ PREDMETE (sada red 9) -->
                <Label text="" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <Button fx:id="ucitajPredmeteBtn" text="🔄 Učitaj dostupne predmete"
                        onAction="#handleUcitajPredmete"
                        GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                <!-- Dugmad (sada red 10) -->
                <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="10" GridPane.columnIndex="1">
                    <Button text="Upiši" onAction="#handleUpis"/>
                    <Button text="Obnova" onAction="#handleObnova"/>
                </HBox>

            </GridPane>
        </content>
    </TitledPane>

    <TitledPane text="Predmeti za upis/obnovu" expanded="true">
        <content>
            <TableView fx:id="predmetiTable" prefHeight="200" editable="true">
                <columns>
                    <TableColumn fx:id="selectCol" text="Izaberi" prefWidth="70"/>
                    <TableColumn fx:id="sifraCol" text="Šifra predmeta" prefWidth="150"/>
                    <TableColumn fx:id="nastavnikCol" text="Naziv predmeta" prefWidth="300"/>
                </columns>
            </TableView>
        </content>
    </TitledPane>

</VBox>
