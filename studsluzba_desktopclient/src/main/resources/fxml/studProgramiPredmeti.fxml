<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.StudProgramiPredmetiController">
    <center>
        <SplitPane dividerPositions="0.25">

            <!-- STUDIJSKI PROGRAMI - KRAĆI -->
            <VBox spacing="8" style="-fx-background-color: #f8f9fa;">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Studijski programi" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>
                <TableView fx:id="studProgramTable" prefHeight="400">
                    <columns>
                        <TableColumn text="Oznaka" fx:id="oznakaCol" prefWidth="60"/>
                        <TableColumn text="Naziv" fx:id="nazivCol" prefWidth="180"/>
                        <TableColumn text="Godina" fx:id="godinaCol" prefWidth="60"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- PREDMETI - DUŽI SA SVEIM KOMPONENTAMA -->
            <VBox spacing="15" style="-fx-background-color: #ffffff;">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <!-- PREDMETI TABELA -->
                <VBox spacing="8">
                    <Label text="Predmeti programa" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <TableView fx:id="predmetTable" prefHeight="350">
                        <columns>
                            <TableColumn text="Šifra" fx:id="sifraCol" prefWidth="70"/>
                            <TableColumn text="Naziv" fx:id="nazivPredmetCol" prefWidth="250"/>
                            <TableColumn text="ESPB" fx:id="espbCol" prefWidth="60"/>
                            <TableColumn text="Obavezan" fx:id="obavezanCol" prefWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <Separator/>

                <!-- DODAVANJE PREDMETA -->
                <VBox spacing="10">
                    <Label text="Dodaj novi predmet" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <GridPane hgap="12" vgap="8" style="-fx-background-color: #f0f2f5; -fx-background-radius: 8;">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="80"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Šifra:" GridPane.rowIndex="0"/>
                        <TextField fx:id="sifraTf" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Naziv:" GridPane.rowIndex="1"/>
                        <TextField fx:id="nazivTf" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="ESPB:" GridPane.rowIndex="2"/>
                        <TextField fx:id="espbTf" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Opis:" GridPane.rowIndex="3"/>
                        <TextField fx:id="opisTf" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <CheckBox text="Obavezan" fx:id="obavezanCb"
                                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Button text="Sačuvaj predmet"
                                onAction="#handleSavePredmet"
                                GridPane.rowIndex="5" GridPane.columnIndex="1"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </GridPane>
                </VBox>

                <Separator/>

                <!-- PROSEČNA OCENA U LABEL-U -->
                <VBox spacing="12">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="godinaOdTf" promptText="Godina od" prefWidth="100"/>
                        <TextField fx:id="godinaDoTf" promptText="Godina do" prefWidth="100"/>
                        <Button text="Izračunaj" onAction="#handleProsek"
                                style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
                        <Button text="Štampaj izveštaj" onAction="#handleIzvestaj"
                                style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #e9ecef; -fx-background-radius: 6; -fx-padding: 15;">
                        <Label text="Prosečna ocena:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <Label fx:id="prosekLabel" text="---"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                    </HBox>
                </VBox>

            </VBox>
        </SplitPane>
    </center>

</BorderPane>
