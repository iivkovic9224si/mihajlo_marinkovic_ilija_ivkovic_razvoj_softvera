<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzbadesktopclient.controllers.MenuBarController">

    <padding>
        <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>
    <HBox spacing="5">
        <Button fx:id="backBtn" text="Nazad" onAction="#goBack"/>
        <Button fx:id="forwardBtn" text="Napred" onAction="#goForward"/>
    </HBox>


    <MenuBar fx:id="menuBar" style="-fx-background-color: #ADD8E6;">

        <!-- STUDENTI -->
        <Menu text="Studenti">
            <items>
                <Menu text="Pretraži">
                    <items>
                        <MenuItem text="Po imenu/prezimenu" onAction="#searchByNameSurname"/>
                        <MenuItem text="Po srednjoj školi" onAction="#searchByHighSchool"/>
                        <MenuItem text="Po indeksu" onAction="#searchByIndex"/>
                    </items>
                </Menu>
                <MenuItem text="Novi" onAction="#openNewStudent"/>
                <MenuItem text="Grupe"/>
            </items>
        </Menu>

        <!-- NASTAVNICI -->
        <Menu text="Nastavnici">
            <items>
                <MenuItem text="Pretraži"/>
                <MenuItem text="Novi"/>
            </items>
        </Menu>

        <!-- PREDMETI -->
        <Menu text="Predmeti">
            <items>
                <MenuItem text="Studijski programi i predmeti" onAction="#openStudProgramiPredmeti"/>
            </items>
        </Menu>

        <!-- NASTAVA I ISPITI -->
        <Menu text="Ispiti">
            <items>
                <MenuItem text="Ispitni rokovi" onAction="#openIspitniRokovi"/>
            </items>
        </Menu>

        <!-- ADMINISTRACIJA -->
        <Menu text="Administracija">
            <items>
                <MenuItem text="Šifarnici"/>
                <MenuItem text="Školske godine"/>
                <MenuItem text="Korisnici"/>
            </items>
        </Menu>

    </MenuBar>
</VBox>
