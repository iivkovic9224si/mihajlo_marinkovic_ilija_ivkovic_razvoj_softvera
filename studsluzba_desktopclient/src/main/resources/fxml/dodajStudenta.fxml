<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzbadesktopclient.controllers.DodajStudentaController"
      spacing="15">

    <fx:define>
        <ToggleGroup fx:id="polGroup"/>
    </fx:define>

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Upis studenta"
               style="-fx-font-size: 16; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Sačuvaj studenta"
                onAction="#handleSacuvaj"
                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <Separator/>

    <ScrollPane fitToWidth="true">
        <VBox spacing="20">

            <!-- 1️⃣ OSNOVNI PODACI -->
            <TitledPane text="Osnovni lični podaci" expanded="true">
                <GridPane hgap="10" vgap="10"
                          style="-fx-background-color: #f0f2f5; -fx-background-radius: 8; -fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Ime:" GridPane.rowIndex="0"/>
                    <TextField fx:id="imeTf" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Prezime:" GridPane.rowIndex="1"/>
                    <TextField fx:id="prezimeTf" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Srednje ime:" GridPane.rowIndex="2"/>
                    <TextField fx:id="srednjeImeTf" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="JMBG:" GridPane.rowIndex="3"/>
                    <TextField fx:id="jmbgTf" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Pol:" GridPane.rowIndex="4"/>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <RadioButton fx:id="muskiRb" text="Muški" toggleGroup="$polGroup"/>
                        <RadioButton fx:id="zenskiRb" text="Ženski" toggleGroup="$polGroup"/>
                    </HBox>

                    <Label text="Datum rođenja:" GridPane.rowIndex="5"/>
                    <DatePicker fx:id="datumRodjenjaDp" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Mesto rođenja:" GridPane.rowIndex="6"/>
                    <TextField fx:id="mestoRodjenjaTf" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                    <Label text="Država rođenja:" GridPane.rowIndex="7"/>
                    <TextField fx:id="drzavaRodjenjaTf" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <Label text="Nacionalnost:" GridPane.rowIndex="8"/>
                    <TextField fx:id="nacionalnostTf" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                </GridPane>
            </TitledPane>

            <!-- 2️⃣ KONTAKT I PREBIVALIŠTE -->
            <TitledPane text="Kontakt i prebivalište" expanded="true">
                <GridPane hgap="10" vgap="10"
                          style="-fx-background-color: #f0f2f5; -fx-background-radius: 8; -fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Email:" GridPane.rowIndex="0"/>
                    <TextField fx:id="emailTf" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Adresa:" GridPane.rowIndex="1"/>
                    <TextField fx:id="adresaTf" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Mesto prebivališta:" GridPane.rowIndex="2"/>
                    <TextField fx:id="mestoPrebivalistaTf" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Državljanstvo:" GridPane.rowIndex="3"/>
                    <TextField fx:id="drzavljanstvoTf" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Mobilni telefon:" GridPane.rowIndex="4"/>
                    <TextField fx:id="brojTelefonaMobilniTf" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Fiksni telefon:" GridPane.rowIndex="5"/>
                    <TextField fx:id="brojTelefonaFiksniTf" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>
            </TitledPane>

            <!-- 3️⃣ DOKUMENTA I BORAVAK -->
            <TitledPane text="Dokumenta i boravak tokom studija" expanded="true">
                <GridPane hgap="10" vgap="10"
                          style="-fx-background-color: #f0f2f5; -fx-background-radius: 8; -fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Broj lične karte:" GridPane.rowIndex="0"/>
                    <TextField fx:id="brojLicneKarteTf" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Ličnu kartu izdao:" GridPane.rowIndex="1"/>
                    <TextField fx:id="licnuKartuIzdaoTf" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Mesto stanovanja:" GridPane.rowIndex="2"/>
                    <TextField fx:id="mestoStanovanjaTf" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Adresa stanovanja:" GridPane.rowIndex="3"/>
                    <TextField fx:id="adresaStanovanjaTf" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </TitledPane>

        </VBox>
    </ScrollPane>
</VBox>
