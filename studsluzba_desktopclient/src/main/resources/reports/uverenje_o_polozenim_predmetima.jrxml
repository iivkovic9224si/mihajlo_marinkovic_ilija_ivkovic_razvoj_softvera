<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="uverenje_o_polozenim_predmetima"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="66d3a103-5f74-4e7f-8626-6cec62e1ced6">

    <property name="net.sf.jasperreports.default.pdf.encoding" value="UTF-8"/>

    <!-- ================= PARAMETERS ================= -->
    <parameter name="pIme" class="java.lang.String"/>
    <parameter name="pPrezime" class="java.lang.String"/>
    <parameter name="pBrojIndeksa" class="java.lang.String"/>
    <parameter name="pStudijskiProgram" class="java.lang.String"/>
    <parameter name="pDatumIzdavanja" class="java.time.LocalDate"/>
    <parameter name="pUkupnoEspb" class="java.lang.Integer"/>
    <parameter name="pProsek" class="java.lang.Double"/>

    <!-- ================= FIELDS ================= -->
    <field name="sifra" class="java.lang.String"/>
    <field name="naziv" class="java.lang.String"/>
    <field name="ocena" class="java.lang.Integer"/>
    <field name="poeni" class="java.lang.Double"/>
    <field name="espb" class="java.lang.Integer"/>
    <field name="datum" class="java.time.LocalDate"/>
    <field name="godinaStudija" class="java.lang.Integer"/>

    <!-- ================= GROUP ================= -->
    <group name="GodinaStudijaGroup">
        <groupExpression><![CDATA[$F{godinaStudija}]]></groupExpression>
        <groupHeader>
            <band height="35">
                <staticText>
                    <reportElement x="0" y="5" width="555" height="25"
                                   backcolor="#E6E6E6"
                                   mode="Opaque"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="16" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Godina studija: ]]></text>
                </staticText>

                <textField>
                    <reportElement x="160" y="5" width="100" height="25"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="16" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{godinaStudija}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <!-- ================= TITLE ================= -->
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="10" width="555" height="40"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="24"/>
                </textElement>
                <text><![CDATA[Uverenje o položenim ispitima]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= PAGE HEADER ================= -->
    <pageHeader>
        <band height="120">
            <textField>
                <reportElement x="0" y="50" width="555" height="60"/>
                <textElement textAlignment="Justified">
                    <font fontName="DejaVu Sans" size="14"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Student " + $P{pIme} + " " + $P{pPrezime} +
                    ", sa brojem indeksa " + $P{pBrojIndeksa} +
                    ", ostvario je " + $P{pUkupnoEspb} +
                    " ESPB sa prosekom " + $P{pProsek} + "."
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="10" width="205" height="20"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Izdato dana: " + $P{pDatumIzdavanja}
                ]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ================= COLUMN HEADER ================= -->
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="60" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Šifra]]></text>
            </staticText>

            <staticText>
                <reportElement x="70" y="5" width="170" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Naziv]]></text>
            </staticText>

            <staticText>
                <reportElement x="250" y="5" width="50" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[ESPB]]></text>
            </staticText>

            <staticText>
                <reportElement x="310" y="5" width="50" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Ocena]]></text>
            </staticText>

            <staticText>
                <reportElement x="370" y="5" width="60" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Poeni]]></text>
            </staticText>

            <staticText>
                <reportElement x="440" y="5" width="100" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Datum]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ================= DETAIL ================= -->
    <detail>
        <band height="25">
            <textField>
                <reportElement x="0" y="5" width="60" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{sifra}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="5" width="170" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[$F{naziv}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="250" y="5" width="50" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{espb}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="310" y="5" width="50" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{ocena}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="370" y="5" width="60" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{poeni}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="440" y="5" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{datum}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
